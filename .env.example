# AI backend: gemini | claude | mock (padrão: mock)
ACTIVE_AI=mock

# Chave da API do Google Gemini (obrigatória quando ACTIVE_AI=gemini)
GEMINI_API_KEY=

# Chave da API da Anthropic Claude (obrigatória quando ACTIVE_AI=claude)
CLAUDE_API_KEY=

# Credenciais do Bitbucket
BITBUCKET_EMAIL=
BITBUCKET_API_TOKEN=
BITBUCKET_WORKSPACE=
BITBUCKET_REPO_SLUG=

# Porta do servidor Flask (padrão: 5000)
# FLASK_RUN_PORT=5000
