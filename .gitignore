# Ambientes Virtuais
venv/
env/
.venv/
.venv-build/

# Variáveis de ambiente
.env

# Configuração de runtime — contém chaves de API e credenciais.
# O modelo versionado é o config.ini.example.
config.ini

# Pasta de contexto de runtime (gerada na primeira execução).
# Os modelos versionados ficam em app/ai_context/.
/ai_context/

# Arquivos temporários do Python
__pycache__/
*.pyc

# Arquivos do Claude Code
.claude

# Payloads de debug do webhook
debug_payloads/

# Dados de teste e logs — não versionar
logs/

# Artefatos de build do PyInstaller
build/
dist/
*.manifest
